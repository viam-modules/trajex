<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>viam_trajex_moveit</name>
  <version>0.101.0</version>
  <description>
    MoveIt 2 planning response adapters that time parameterize with trajex, Viam's implementation of
    time-optimal trajectory generation. The adapters and their parameters may still change.
  </description>
  <maintainer email="andrew.morrow@viam.com">Andrew Morrow</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/viam-modules/trajex</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The package's CMake builds trajex from this repository. We declare trajex's xtensor dependency so that rosdep
       installs it. rosdep has no key for xtl, but the xtensor package depends on it, so it gets installed too. -->
  <depend>xtensor</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>moveit_resources_panda_description</test_depend>
  <!-- MoveIt's planning pipeline, and its own time parameterization adapter, which a test loads alongside ours to
       check that they share parameters cleanly. -->
  <test_depend>moveit_ros_planning</test_depend>
  <!-- The planner for the end to end test through the planning pipeline. -->
  <test_depend>moveit_planners_ompl</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
